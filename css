/* ==========================================================================
   SecOS Modern Cyberpunk Theme & Responsive Layout
   ========================================================================== */

/* 1. Root Design Tokens & Variables */
:root {
  --bg-primary: #0a0c10;
  --bg-secondary: #12161f;
  --bg-terminal: #05070a;
  --border-color: #1f293d;
  --border-accent: #00ff66;
  
  --text-main: #e2e8f0;
  --text-muted: #8b949e;
  --accent-green: #00ff66;
  --accent-cyan: #00e5ff;
  --accent-alert: #ff3366;
  
  --font-mono: 'Fira Code', 'JetBrains Mono', 'Share Tech Mono', monospace;
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  
  --radius-sm: 4px;
  --radius-md: 8px;
  --transition-fast: 0.2s ease-in-out;
}

/* 2. Base Reset & Scanline Background */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-primary);
  color: var(--text-main);
  font-family: var(--font-mono);
  line-height: 1.6;
  overflow-x: hidden;
  position: relative;
}

/* Subtle Overlay Scanline Effect (Non-intrusive) */
body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(
    rgba(18, 16, 16, 0) 50%, 
    rgba(0, 0, 0, 0.25) 50%
  );
  background-size: 100% 4px;
  z-index: 9999;
  pointer-events: none;
  opacity: 0.6;
}

/* 3. Interactive Terminal Layout (Mobile-Optimized) */
.terminal-window {
  background-color: var(--bg-terminal);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 10px rgba(0, 255, 102, 0.05);
  margin: 1.5rem 0;
  overflow: hidden;
  width: 100%;
}

.terminal-header {
  background-color: var(--bg-secondary);
  padding: 0.5rem 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-color);
}

.terminal-dots {
  display: flex;
  gap: 6px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}
.dot.red { background-color: var(--accent-alert); }
.dot.yellow { background-color: #ffbd2e; }
.dot.green { background-color: var(--accent-green); }

.terminal-title {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.terminal-body {
  padding: 1rem;
  font-size: 0.9rem;
  color: var(--accent-green);
  overflow-x: auto;
  word-break: break-word;
}

.terminal-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.terminal-prompt {
  color: var(--accent-cyan);
  font-weight: bold;
}

.terminal-input {
  background: transparent;
  border: none;
  color: var(--text-main);
  font-family: var(--font-mono);
  font-size: 0.9rem;
  outline: none;
  flex: 1;
  min-width: 150px;
}

/* 4. Responsive Project Card Grid */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  padding: 1rem 0;
}

.project-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.project-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent-green);
  box-shadow: 0 6px 20px rgba(0, 255, 102, 0.1);
}

.project-card h3 {
  color: var(--accent-cyan);
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
}

.project-card p {
  color: var(--text-muted);
  font-size: 0.85rem;
  line-height: 1.5;
  margin-bottom: 1.25rem;
  font-family: var(--font-sans);
}

.project-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--accent-green);
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 600;
  min-height: 44px; /* Touch target size for mobile */
  padding: 0.25rem 0;
}

.project-link:hover {
  text-decoration: underline;
}

/* 5. Mobile Accessibility & Touch Optimization */
@media (max-width: 600px) {
  body {
    font-size: 14px;
  }

  .terminal-body {
    padding: 0.75rem;
    font-size: 0.8rem;
  }

  .projects-grid {
    grid-template-columns: 1fr; /* Full-width single column on narrow screens */
    gap: 1rem;
  }

  .project-card {
    padding: 1rem;
  }
}
